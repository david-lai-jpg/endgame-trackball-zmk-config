#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/adaptive_feedback.h>
#include <dt-bindings/zmk/bistable_behavior.h>
#include <dt-bindings/zmk/p2sm.h>

#ifndef LAYER_DEFAULT
#define LAYER_DEFAULT      0
#define LAYER_DEVICE       1
#define LAYER_SCROLL       2
#define LAYER_SNIPE        3
#endif

#define ENC_SCROLL sensor-bindings = <&scroll_encoder &rotenc_follower 9 11>

/ {
	keymap {
		compatible = "zmk,keymap";

		default_layer {
			display-name = "Default";
			ENC_SCROLL;
			bindings = <
				// buttons
				&ltmkp LAYER_SNIPE F1     &ltmkp LAYER_SCROLL F2
				&kp F12                   &ltmkp LAYER_SCROLL F3
				&mkp LCLK                 &ltm LAYER_SCROLL RCLK
				&ltm LAYER_SNIPE LCLK     &ltm LAYER_DEVICE RCLK

				// rotary encoders (left = scroll, right = tab switching)
				&none                     &kp LC(TAB)
				&none                     &kp LC(LS(TAB))
			>;
		};

		layer1 {
			display-name = "Device";
			DECLARE_ENCODERS;
			bindings = <
				&soft_off          &zbs_adv
				&bt BT_CLR         &bt BT_NXT
				&kp C_MUTE         &bt BT_PRV
				&kp C_PP           &studio_unlock

				&kp C_VOL_UP       &kp C_NEXT
				&kp C_VOL_DN       &kp C_PREV
			>;
		};

		layer2 {
			display-name = "Scroll";
			DECLARE_ENCODERS;
			bindings = <
				&trans              &trans
				&trans              &trans
				&trans              &trans
				&trans              &trans

				&trans              &trans
				&trans              &trans
			>;
		};

		layer3 {
			display-name = "Snipe";
			ENC_SCROLL;
			bindings = <
				&trans           &trans
				&trans           &trans
				&trans           &trans
				&trans           &trans

				&trans           &trans
				&trans           &trans
			>;
		};
	};

	behaviors {
		scroll_encoder: scroll_encoder {
			compatible = "zmk,behavior-sensor-rotate";
			#sensor-binding-cells = <0>;
			bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
		};
	};

	trackball {
		input-processors = <&zip_bistable_twist_scaler>,
						   <&zip_pointer_accel>, <&zip_scroll_accel>,
						   <&zip_rotate_pointer>, <&zip_rotate_scroll>,
						   <&esb_ip>, <&zip_ble_report_rate_limit>;

		scroll {
			layers = <LAYER_SCROLL>;
			input-processors = <&zip_bistable_scroll_xy_scaler>, <&zip_axis_clamper>,
							   <&zip_xy_to_scroll_mapper>, <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,
							   <&zip_dragscroll_accel>, <&zip_rotate_scroll>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};

		snipe {
			layers = <LAYER_SNIPE>;
			input-processors = <&zip_bistable_snipe_scaler>,
							   <&zip_rotate_pointer>, <&zip_rotate_scroll>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};
	};
};
